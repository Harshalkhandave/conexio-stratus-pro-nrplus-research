config CARRIER
	int "Carrier to use"
	default 0
	help
	   The availability of the channels and the exact regulation to use them varies in different countries.
	   See ETSI TS 103 636-2 5.4.2 for the calculation.
	   Band index 1 is set when the carrier is within the range of 525 to 551.
	   This is the only range allowed for band index 1 as other carriers will interfere with other radio devices, including LTE devices.

config NETWORK_ID
	int "Network ID"
	range 1 4294967295
	default 91

config MCS
	int "MCS"
	default 0
	help
	   The MCS impacts how much data can fit into each subslot.

config TX_POWER
	int "TX power"
	range 0 13
	default 13
	help
	   Transmission power, max 19 dBm due to hardware limitations.
	   See table 6.2.1-3 of ETSI TS 103 636-4 v1.5.1.

config TX_TRANSMISSIONS
	int "TX transmissions"
	range 0 4294967295
	default 0
	help
	   Number of TX packets before the application exits.
	   Use 0 to transmit forever (tx_rx / tx_only modes).

config RX_PERIOD_S
	int "RX period"
	default 5
	help
	   Receive window period in seconds (tx_rx and rx_only modes).

config TX_INTERVAL_MS
	int "Extra interval between iterations (ms)"
	default 500
	help
	   Sleep after each TX (tx_only) or after each TX+RX cycle (tx_rx).
	   Ignored in rx_only mode.

choice EXPERIMENT_TEST_MODE
	prompt "Experiment test mode"
	default EXPERIMENT_TEST_MODE_TX_RX
	help
	   Role of this board in the experiment.

config EXPERIMENT_TEST_MODE_TX_RX
	bool "TX then RX (default)"
	help
	   Transmit one packet, then listen for CONFIG_RX_PERIOD_S seconds.

config EXPERIMENT_TEST_MODE_TX_ONLY
	bool "TX only"
	help
	   Transmit only; pace with CONFIG_TX_INTERVAL_MS.

config EXPERIMENT_TEST_MODE_RX_ONLY
	bool "RX only"
	help
	   Receive only; repeated RX windows of CONFIG_RX_PERIOD_S.

endchoice

config EXPERIMENT_PACKET_SIZE
	int "On-air packet size (bytes)"
	range 15 32
	default 15
	help
	   Total PDC payload size. Must be >= sizeof(experiment_packet) (15).
	   Extra bytes are zero-padded after the header.

config EXPERIMENT_MESSAGE_TYPE
	int "Payload message_type field"
	range 0 255
	default 1
	help
	   Application message type written into each packet (1 = baseline).

config EXPERIMENT_DEST_RECEIVER_ID
	int "RX filter destination identity"
	range 0 65535
	default 0
	help
	   PHY RX filter receiver_identity. 0 = broadcast / accept all (v1.0).
	   Non-zero reserved for future unicast filtering.

config EXPERIMENT_DEVICE_ID_OVERRIDE
	bool "Override hardware device ID"
	default n
	help
	   When enabled, use CONFIG_EXPERIMENT_DEVICE_ID instead of hwinfo.

config EXPERIMENT_DEVICE_ID
	int "Device ID override value"
	depends on EXPERIMENT_DEVICE_ID_OVERRIDE
	range 1 65535
	default 1

config EXPERIMENT_LOG_COMPACT
	bool "Compact experiment logging (TX:/RX: only)"
	default y
	help
	   Emit machine-parseable TX: and RX: lines at INF.
	   Extra human-readable bring-up logs stay at DBG.

module = DECT_PHY_HELLO
module-str = DECT NR+ PHY Hello
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
